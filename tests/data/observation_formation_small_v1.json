{
  "schema_version": "observation.formation.small.v1",
  "purpose": "Small fixed development and validation benchmark for Observation formation. All texts predate the root-dataset generalization audit.",
  "formation_policy": {
    "should_form": "The utterance contains a committed or scoped attitude toward an identifiable office-work object.",
    "should_not_form": "System facts, explicit do-not-remember instructions, or standalone references whose attitude subject cannot be resolved.",
    "frame_correct": "Condition, object, attitude direction and temporal scope must all fit one expected frame.",
    "development_rule": "Only the development split may be used while adjusting the algorithm. Validation remains sealed until parameters are frozen."
  },
  "options": {
    "condition_tag_ids": [
      "app:chatgpt_codex",
      "app:web_browser",
      "app:spreadsheet",
      "app:word_processor",
      "app:presentation",
      "app:terminal",
      "task:financial_summary",
      "task:budget_comparison",
      "task:sales_trend",
      "task:code_explanation",
      "task:ordinary_chat",
      "task:quote_email",
      "task:report",
      "condition:external_email",
      "condition:network_unstable"
    ],
    "object_tag_ids": [
      "app:chatgpt_codex",
      "chart:bar",
      "chart:line",
      "document:template",
      "setting:preference",
      "artifact:budget_sheet",
      "action:confirm_before_send",
      "tool:company_api",
      "action:manual_quote_check"
    ],
    "temporal_labels": [
      "temporal_short",
      "temporal_medium",
      "temporal_long"
    ]
  },
  "custom_tags": [
    {
      "tag_id": "condition:external_email",
      "name": "External Email Workflow",
      "groups": ["condition"],
      "aliases": ["External Email Workflow", "对外邮件流程"],
      "prototypes": [
        "给外部客户发送带附件的邮件",
        "邮件向组织外部正式发出之前"
      ]
    },
    {
      "tag_id": "condition:network_unstable",
      "name": "Unstable Network Condition",
      "groups": ["condition"],
      "aliases": ["Unstable Network Condition", "网络异常条件"],
      "prototypes": [
        "网络连接不稳定或者公司接口不可用时",
        "在线服务暂时无法可靠使用的场景"
      ]
    },
    {
      "tag_id": "action:confirm_before_send",
      "name": "Confirm Before Sending",
      "groups": ["object"],
      "aliases": ["Confirmation Gate", "发送确认机制"],
      "prototypes": [
        "邮件真正发出之前先询问用户确认",
        "对外发送内容前必须获得用户批准"
      ]
    },
    {
      "tag_id": "tool:company_api",
      "name": "Company Quotation API",
      "groups": ["object"],
      "aliases": ["Enterprise Quotation API", "企业报价接口"],
      "prototypes": [
        "使用公司的在线接口自动处理报价",
        "通过企业 API 获取或核验报价数据"
      ]
    },
    {
      "tag_id": "action:manual_quote_check",
      "name": "Manual Quote Verification",
      "groups": ["object"],
      "aliases": ["Manual Quote Verification", "人工报价核验"],
      "prototypes": [
        "不用在线接口而是手工检查报价表",
        "人工核对报价数据是否正确"
      ]
    }
  ],
