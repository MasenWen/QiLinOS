# 部署模板：安装时请将 <PROJECT_ROOT> 替换为实际项目绝对路径（本文件不含机器专属路径）
[Unit]
Description=NexAgent WebChat (8080)
After=network.target

[Service]
Type=simple
User=kylin
WorkingDirectory=<PROJECT_ROOT>
ExecStart=/home/kylin/work/projects/project_dev1/.venv/bin/python -X faulthandler /home/kylin/work/projects/project_dev1/webchat.py 8080
Restart=always
RestartSec=3
StandardOutput=append:<PROJECT_ROOT>/webchat.log
StandardError=append:<PROJECT_ROOT>/webchat.log

[Install]
WantedBy=multi-user.target
