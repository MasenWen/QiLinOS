[Unit]
Description=NexAgent WebChat (8080)
After=network.target

[Service]
Type=simple
User=kylin
WorkingDirectory=/home/kylin/work/projects/project_dev1
ExecStart=/home/kylin/work/projects/project_dev1/.venv/bin/python -X faulthandler /home/kylin/work/projects/project_dev1/webchat.py 8080
Restart=always
RestartSec=3
StandardOutput=append:/home/kylin/work/projects/project_dev1/webchat.log
StandardError=append:/home/kylin/work/projects/project_dev1/webchat.log

[Install]
WantedBy=multi-user.target
