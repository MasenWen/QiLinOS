# 部署模板：安装时请将 <PROJECT_ROOT> 替换为实际项目绝对路径（本文件不含机器专属路径）
[Unit]
Description=GitHub Webhook auto-update for webchat (dev1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kylin
WorkingDirectory=<PROJECT_ROOT>
EnvironmentFile=/etc/webhook.env
ExecStart=/usr/bin/python3 <PROJECT_ROOT>/deploy/webhook_server.py 9000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
